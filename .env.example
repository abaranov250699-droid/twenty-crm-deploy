# ==========================================
# Конфигурация Twenty CRM для Neon + Render
# ==========================================

# 1. База данных Neon (ОБЯЗАТЕЛЬНО Direct connection, БЕЗ -pooler!)
PG_DATABASE_URL=postgresql://user:password@ep-example-123456.eu-central-1.aws.neon.tech/neondb?sslmode=require

# 2. Redis (Upstash Redis или Render Redis)
# Для Upstash: rediss://default:password@eu-central-1.upstash.io:6379
REDIS_URL=redis://your-redis-url:6379

# 3. Публичный адрес приложения на Render (без слэша на конце)
SERVER_URL=https://twenty-server.onrender.com

# 4. Порт (Twenty слушает 3000)
NODE_PORT=3000
PORT=3000

# 5. Ключи шифрования (сгенерированные 256-битные ключи base64)
ENCRYPTION_KEY=Non+dLbWz2Q4LgJQVDEjui1pFQf7P9+nzyLTmwg4FyY=
APP_SECRET=BVzCsmzyxLb/320JuWy67yU4HQl74RMSxqAhyjOgOWI=

# Память Node.js для предотвращения OOM при миграциях
NODE_OPTIONS=--max-old-space-size=420

# 6. Хранилище (local или s3)
STORAGE_TYPE=local

# 7. Миграции (на сервере false, на воркере true)
DISABLE_DB_MIGRATIONS=false
DISABLE_CRON_JOBS_REGISTRATION=false
